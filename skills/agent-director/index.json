{
  "name": "agent-director",
  "version": "2.2.0",
  "description": "Zero-interruption autonomous orchestration with Loop-Until-Final-Output (LUFO). Infers full action chains from intent. Full SDLC team roles. Provide intent, agents execute and VERIFY end-to-end.",
  "author": "akshat.garg@salesforce.com",
  "proficiency": {
    "current_pl": "PL3",
    "current_stage": 7,
    "stage_name": "Manager of Agent Managers",
    "percentile": 0.93,
    "target_stage": 9,
    "target_name": "Trusted Automation & Autonomy"
  },
  "workflows": {
    "execute": {
      "name": "agent-director-execute",
      "description": "Full SDLC pipeline: PM → Architect → Dev → Review → Test → QA → Ship",
      "roles": ["product_manager", "architect", "developer", "reviewer", "tester", "qa_manager", "devops"],
      "use_when": "build, fix, ship — any usecase that produces code"
    },
    "spike": {
      "name": "agent-director-spike",
      "description": "Technical spike: parallel POC exploration → evaluate → recommend",
      "roles": ["product_manager", "developer", "reviewer", "engineering_manager"],
      "use_when": "feasibility questions, approach selection, POC comparison before committing"
    },
    "research": {
      "name": "agent-director-research",
      "description": "Multi-source investigation → verify → synthesize",
      "roles": ["research_director", "specialist", "verifier", "synthesizer"],
      "use_when": "pure research, no code changes — investigation, analysis, due diligence"
    }
  },
  "team_roles": {
    "product_manager": {
      "real_world_mirror": "PM who writes PRDs",
      "responsibilities": ["requirements", "user stories", "acceptance criteria", "prioritization", "success metrics"],
      "outputs": ["product brief", "MoSCoW stories", "acceptance criteria"]
    },
    "architect": {
      "real_world_mirror": "Tech Lead / Staff Engineer",
      "responsibilities": ["design", "patterns", "interfaces", "data models", "build order"],
      "outputs": ["technical design", "component blueprint", "API contracts"]
    },
    "developer": {
      "real_world_mirror": "IC Engineer on the team",
      "responsibilities": ["TDD implementation", "unit tests", "commits"],
      "outputs": ["working code", "passing tests", "implementation notes"],
      "parallelism": "one per component, isolated worktrees"
    },
    "reviewer": {
      "real_world_mirror": "Senior Engineer doing PR review",
      "responsibilities": ["code review", "bug detection", "security audit", "design compliance"],
      "outputs": ["verdict", "issue list with fixes", "quality score"]
    },
    "tester": {
      "real_world_mirror": "QA Engineer writing test suites",
      "responsibilities": ["test plan", "unit/integration/edge tests", "bug reporting"],
      "outputs": ["test results", "coverage report", "bug reports with repro"]
    },
    "qa_manager": {
      "real_world_mirror": "QA Lead giving ship/no-ship",
      "responsibilities": ["acceptance validation", "release sign-off", "release notes"],
      "outputs": ["go/no-go verdict", "validated criteria", "release notes"]
    },
    "devops": {
      "real_world_mirror": "Release Engineer / DevOps",
      "responsibilities": ["PR creation", "CI validation", "release packaging"],
      "outputs": ["PR with context", "deployment notes"]
    },
    "engineering_manager": {
      "real_world_mirror": "EM making go/no-go decisions",
      "responsibilities": ["synthesis", "recommendation", "risk acceptance"],
      "outputs": ["recommendation with rationale", "implementation path"]
    }
  },
  "usecase_types": ["build", "fix", "research", "ship", "plan", "operate", "spike"],
  "routing": {
    "build": "execute",
    "fix": "execute",
    "ship": "execute",
    "research": "research",
    "plan": "spike",
    "operate": "execute",
    "spike": "spike"
  },
  "escalation_policy": {
    "max_retries": 3,
    "auto_fix_on": ["review_changes_requested", "test_bugs_found", "build_failure", "deploy_failure"],
    "block_ship_on": ["qa_fail", "security_critical"],
    "escalate_to_director_on": ["ambiguous_requirements", "external_dependency", "risk_decision"]
  },
  "lufo_protocol": {
    "description": "Loop Until Final Output — never stop at intermediate states",
    "version": "1.0.0",
    "core_rule": "The deliverable is the VERIFIED END STATE, not a triggered/submitted intermediate",
    "verification_targets": {
      "deploy": "Live URL returning HTTP 200",
      "build": "Exit code 0 with no errors",
      "ci": "All checks green",
      "push": "Remote ref updated successfully",
      "pr": "PR URL returned and accessible"
    },
    "retry_limits": {
      "deploy": 3,
      "build": 3,
      "push": 2,
      "ci": 2
    },
    "poll_intervals_seconds": {
      "deploy": 30,
      "ci": 30,
      "dns": 60
    },
    "max_wait_seconds": {
      "deploy": 300,
      "ci": 300,
      "dns": 600
    },
    "anti_patterns": [
      "Deploy triggered, check your dashboard",
      "I pushed, CI should run automatically",
      "Here are steps for you to run",
      "Give it a minute and check",
      "Build passed locally, should work remotely"
    ],
    "escalation_only_on": [
      "Paid feature required (Vercel Pro, etc.)",
      "External auth/token needed that agent cannot access",
      "DNS propagation (external, not controllable)",
      "Rate limiting after max retries exhausted"
    ]
  },
  "action_inference": {
    "description": "Maps Director intent to full execution chains. NEVER pause mid-chain to ask for confirmation.",
    "always_implied": {
      "before_any_repo_work": ["git_pull"],
      "after_any_code_change": ["run_tests", "git_commit", "git_push"],
      "after_feature_work": ["create_pr"]
    },
    "scope_calibration": {
      "casual": {
        "signals": ["update", "fix typo", "rename", "add comment", "tweak", "clean up", "small change"],
        "action": "direct_execution",
        "use_agents": false,
        "always_commit_push": true
      },
      "medium": {
        "signals": ["refactor", "add error handling", "improve", "extract", "reorganize", "optimize"],
        "action": "focused_agents",
        "use_agents": true,
        "agent_count": "1-2",
        "always_commit_push": true
      },
      "full_mission": {
        "signals": ["build", "create", "design", "implement", "develop", "architect", "new service", "new feature"],
        "action": "workflow_dispatch",
        "use_agents": true,
        "workflow": "execute",
        "always_commit_push": true
      }
    },
    "never_ask": [
      "Should I commit?",
      "Should I push?",
      "Should I pull first?",
      "Should I run tests?",
      "Should I create a branch?",
      "What commit message should I use?",
      "Do you want me to also do X?",
      "Should I include this file?",
      "Want me to proceed?"
    ]
  }
}
